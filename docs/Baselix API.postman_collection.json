            "description": "Create one or more records. If the table does not exist, Baselix creates it automatically from the submitted payload.",
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"email\": \"ada@example.com\",\n    \"age\": 34,\n    \"is_active\": true,\n    \"joined_at\": \"2026-04-01T10:00:00Z\",\n    \"profile\": {\n      \"plan\": \"pro\",\n      \"region\": \"eu-west-1\"\n    }\n  },\n  {\n    \"email\": \"grace@example.com\",\n    \"age\": 29,\n    \"is_active\": false,\n    \"joined_at\": \"2026-04-03T15:30:00Z\",\n    \"profile\": {\n      \"plan\": \"free\",\n      \"region\": \"us-east-1\"\n    }\n  }\n]",
              "options": {
                "raw": {
                  "language": "json"
                }
