            "body": {
              "mode": "raw",
              "raw": "{\n  \"schema\": {\n    \"email\": \"string_u\",\n    \"age\": \"int\",\n    \"is_active\": \"bool\",\n    \"tier\": \"string\"\n  },\n  \"allow_destructive\": true\n}",
              "options": {
