    {
      "name": "Records",
      "item": [
        {
          "name": "List Records",
          "request": {
            "method": "GET",
            "header": [],
            "description": "List records from a table with optional filter and sort query parameters.",
            "url": {
              "raw": "{{baseUrl}}/api/v1/tables/{{tableName}}?filter=joined_at:gte:2026-04-01T00:00:00Z&sort=created_at:desc,email:asc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "tables",
                "{{tableName}}"
              ],
              "query": [
                {
                  "key": "filter",
                  "value": "joined_at:gte:2026-04-01T00:00:00Z"
                },
                {
                  "key": "sort",
                  "value": "created_at:desc,email:asc"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Record By ID",
          "request": {
            "method": "GET",
            "header": [],
