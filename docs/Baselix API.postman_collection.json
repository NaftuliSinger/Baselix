            "description": "Create a table with an explicit schema.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"schema\": {\n    \"email\": \"string_u\",\n    \"age\": \"int\",\n    \"is_active\": \"bool\",\n    \"joined_at\": \"time\",\n    \"profile\": \"json\"\n  }\n}",
              "options": {
