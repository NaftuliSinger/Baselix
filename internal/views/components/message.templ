package components

templ MessageContainer() {
    <!-- Messages Container -->
	<div id="messages-container" class="fixed top-4 right-4 z-50 flex flex-col gap-2">
        <div id="message" hidden></div>
    </div>

}

templ Message(message string, messageType string) {
    switch messageType {
    case "success":
        <div 
            id="message" 
            hx-swap-oob="true" 
            x-data="{ show: true }" 
            x-show="show" 
            x-init="setTimeout(() => show = false, 3000)" 
            class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative" 
            role="alert"
        >
            <span class="block sm:inline">{ message }</span>
        </div>
    case "error":
        <div 
            id="message" 
            hx-swap-oob="true" 
            x-data="{ show: true }" 
            x-show="show" 
            x-init="setTimeout(() => show = false, 3000)" 
            class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative" 
            role="alert"
        >
            <span class="block sm:inline">{ message }</span>
        </div>
    default:
        <div 
            id="message" 
            hx-swap-oob="true" 
            x-data="{ show: true }" 
            x-show="show" 
            x-init="setTimeout(() => show = false, 3000)" 
            class="bg-gray-100 border border-gray-400 text-gray-700 px-4 py-3 rounded relative" 
            role="alert"
        >
            <span class="block sm:inline">{ message }</span>
        </div>
    }
}