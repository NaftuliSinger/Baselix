package components

templ Nav() {
    <nav class="bg-gray-900 shadow-md fixed top-0 w-full z-50">
        <div class="container mx-auto px-4 py-3 flex items-center justify-between">

            <!-- Logo + Name as single home link -->
            <a href="/" class="flex items-center space-x-2">
                <img src="/static/media/logo.ico" alt="Baselix Logo" class="h-8 w-8"/>
                <span class="text-white text-xl font-bold tracking-wide">Baselix</span>
            </a>

            <!-- Navigation links -->
            <ul class="flex items-center space-x-6">
                <li><a href="/dashboard" class="text-gray-300 hover:text-white transition-colors">Dashboard</a></li>

                <!-- Clerk Auth Area -->
                <li id="clerk-auth-area" class="flex items-center justify-center min-w-[100px] h-9" style="visibility:hidden;">
                    <a id="clerk-sign-in-link" href="/sign-in" class="flex items-center bg-indigo-600 hover:bg-indigo-700 text-white px-4 rounded-lg text-sm font-semibold transition-colors h-9">
                        Sign In
                    </a>
                    <div id="clerk-user-button" class="flex items-center justify-center h-9" style="display:none;"></div>
                </li>
            </ul>
        </div>
    </nav>
}