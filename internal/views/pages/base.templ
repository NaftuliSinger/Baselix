package pages

import "baselix/internal/views/components"

templ Base(publishableKey string, content templ.Component) {
<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8"/>
	<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
	<title>Baselix</title>
	<link rel="icon" type="image/png" href="/static/media/logo.ico"/>

	<script src="https://cdn.tailwindcss.com"></script>
	<script src="https://unpkg.com/htmx.org@1.9.10"></script>
	<script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>

	<!-- Clerk integration -->
	<script>
		let clerkLoaded = false;

		async function onClerkLoad() {
			if (!window.Clerk || clerkLoaded) return;
			clerkLoaded = true;

			// Load Clerk
			await window.Clerk.load();

			// Ensure session is fully ready + cookie synced
			if (window.Clerk.session) {
				try {
					await window.Clerk.session.getToken();
				} catch (e) {
					console.warn("Clerk session token fetch failed:", e);
				}
			}

			const authArea = document.getElementById('clerk-auth-area');
			const signInLink = document.getElementById('clerk-sign-in-link');
			const userBtn = document.getElementById('clerk-user-button');
			const protectedEl = document.getElementById('clerk-protected-page');
			const signInEl = document.getElementById('clerk-sign-in');

			const isSignedIn = !!window.Clerk.session;

			// ---- AUTH UI ----
			if (isSignedIn) {
				if (signInLink) signInLink.style.display = 'none';

				if (userBtn) {
					userBtn.style.display = 'flex';
					userBtn.innerHTML = '';
					window.Clerk.mountUserButton(userBtn);
				}
			} else {
				if (signInLink) signInLink.style.display = '';
				if (userBtn) userBtn.style.display = 'none';
			}

			// ---- PROTECTED CONTENT ----
			if (protectedEl) {
				protectedEl.style.opacity = isSignedIn ? '1' : '0';
				protectedEl.style.pointerEvents = isSignedIn ? '' : 'none';
			}

			// ---- SIGN-IN COMPONENT ----
			if (signInEl && !isSignedIn) {
				signInEl.innerHTML = '';
				window.Clerk.mountSignIn(signInEl, {
					fallbackRedirectUrl: "/auth/callback",
				});
			}

			// ---- REVEAL UI (no flicker) ----
			if (authArea) {
				authArea.style.visibility = 'visible';
			}
		}
	</script>

	<!-- PostHog integration-->
	<script>
		!function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.crossOrigin="anonymous",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="init capture register register_once register_for_session unregister unregister_for_session getFeatureFlag getFeatureFlagPayload isFeatureEnabled reloadFeatureFlags updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures on onFeatureFlags onSessionId getSurveys getActiveMatchingSurveys renderSurvey canRenderSurvey getNextSurveyStep identify setPersonProperties group resetGroups setPersonPropertiesForFlags resetPersonPropertiesForFlags setGroupPropertiesForFlags resetGroupPropertiesForFlags reset get_distinct_id getGroups get_session_id get_session_replay_url alias set_config startSessionRecording stopSessionRecording sessionRecordingStarted captureException loadToolbar get_property getSessionProperty createPersonProfile opt_in_capturing opt_out_capturing has_opted_in_capturing has_opted_out_capturing clear_opt_in_out_capturing debug".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
		posthog.init('phc_qRHRzCzEt4iqeiDksm3WHrsBpLUxVSppBQ3P3ecgKxyi',{api_host:'https://eu.i.posthog.com', defaults:'2026-01-30'})
	</script>

	<!-- Crisp integration -->
	<script type="text/javascript">window.$crisp=[];window.CRISP_WEBSITE_ID="c820cae3-a882-4fdd-a63d-e9e1fa597940";(function(){d=document;s=d.createElement("script");s.src="https://client.crisp.chat/l.js";s.async=1;d.getElementsByTagName("head")[0].appendChild(s);})();</script>
</head>

<body class="bg-gray-100 h-screen overflow-hidden font-sans text-gray-900">
	@components.Nav()
	@components.MessageContainer()
	<main class="mt-24 pb-20 sm:pb-12 overflow-y-auto h-[calc(100vh-6rem)]">
		<div class="container mx-auto px-4 py-8">
			@content
		</div>
	</main>
	@components.ModalRoot()
	@components.Footer()

	if publishableKey != "" {
		<script
			async
			crossorigin="anonymous"
			data-clerk-publishable-key={ publishableKey }
			src="https://unpkg.com/@clerk/clerk-js@5/dist/clerk.browser.js"
			onload="onClerkLoad()">
		</script>
	}
</body>
</html>
}