package pages

import "baselix/internal/views/components"

templ Base(publishableKey string, content templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>Baselix</title>
		<script src="https://cdn.tailwindcss.com"></script>
		<script src="https://unpkg.com/htmx.org@1.9.10"></script>
		<script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>
		<script>
			async function onClerkLoad() {
				if (!window.Clerk) return;
				await window.Clerk.load({
					routerPush: function(to) { window.location.href = to; },
					routerReplace: function(to) { window.location.replace(to); },
				});

				var signInLink = document.getElementById('clerk-sign-in-link');
				var userBtn = document.getElementById('clerk-user-button');

				if (window.Clerk.user) {
					if (signInLink) signInLink.style.display = 'none';
					if (userBtn) {
						userBtn.style.display = 'flex';
						window.Clerk.mountUserButton(userBtn);
					}
				}

				var signInEl = document.getElementById('clerk-sign-in');
				if (signInEl) {
					if (window.Clerk.user) {
						window.location.replace('/dashboard');
					} else {
						window.Clerk.mountSignIn(signInEl, { fallbackRedirectUrl: '/dashboard' });
					}
				}
			}
		</script>
	</head>
	<body class="bg-gray-100 min-h-screen font-sans text-gray-900">
		@components.Nav()
		<main class="container mx-auto px-4 py-8">
			@content
		</main>
		if publishableKey != "" {
			<script async crossorigin="anonymous" data-clerk-publishable-key={ publishableKey } src="https://unpkg.com/@clerk/clerk-js@5/dist/clerk.browser.js" onload="onClerkLoad()"></script>
		}
	</body>
	</html>
}