package pages

import (
	"baselix/internal/views/components"
)
templ Dashboard(userID string, sessionID string) {
    <div class="max-w-4xl mx-auto space-y-6">

        <!-- Header -->
        <div class="flex items-center justify-between">
            <h1 class="text-xl font-semibold text-gray-800">Projects</h1>
        </div>

        <!-- Inline Create -->
        @components.ProjectInlineForm()

        <!-- Table -->
        <div
            id="project-list"
            hx-get="/projects"
            hx-trigger="load, projects-updated from:body"
            hx-target="#project-list"
            hx-swap="innerHTML"
        >
        </div>

    </div>
}