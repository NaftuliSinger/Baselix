package pages

templ Index() {
	<div class="flex flex-col items-center justify-center min-h-[70vh]">
		<div class="bg-white rounded-2xl shadow-lg p-10 max-w-md w-full text-center">
			<h1 class="text-4xl font-bold text-gray-800 mb-3">Welcome to Baselix</h1>
			<p class="text-gray-500 mb-8">A modern Go web starter kit.</p>
			<a href="/dashboard" class="inline-block bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-6 py-3 rounded-lg transition-colors">
				Go to Dashboard
			</a>
		</div>
	</div>
}