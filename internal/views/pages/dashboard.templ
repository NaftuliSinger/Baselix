package pages

import (
	"baselix/internal/views/components"
)
templ Dashboard(userID string, sessionID string) {
    <div class="max-w-4xl mx-auto space-y-6">

       	<!-- Header -->
		<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
			<h1 class="text-xl font-semibold text-gray-800">
				Projects
			</h1>
			<p class="text-sm text-gray-600 sm:ml-4">
				Manage your projects and API keys. For all other operations, please use the API, the documentation is available
				<a href="/docs" target="_blank" class="text-indigo-600 hover:underline">here</a>.
			</p>
		</div>


        <!-- Inline Create -->
        @components.ProjectInlineForm()

        <!-- Table -->
        <div
            id="project-list"
            hx-get="/projects"
            hx-trigger="load, projects-updated from:body"
            hx-target="#project-list"
            hx-swap="innerHTML"
        >
        </div>

    </div>
}